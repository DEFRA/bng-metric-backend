save-exact=true
min-release-age=7

# npm 12 refuses git dependencies by default (allow-git=none). bng-library is pinned to a
# GitHub commit, so allow git only for dependencies declared directly in package.json —
# a transitive dependency still cannot pull from a git remote.
allow-git=root

# Supply-chain hardening: stop npm auto-running preinstall/install/postinstall/prepare
# scripts — ours or any dependency's — during `npm install` / `npm ci`. That's the vector
# recent npm worm attacks (e.g. Shai-Hulud) used to execute code at install time.
# `npm run <script>` still works for anything invoked explicitly — see README's
# "Setup" section under Secret scanning for what to run after installing, and how to
# override for a package that genuinely needs its install script.
ignore-scripts=true

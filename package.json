{
  "name": "bng-metric-backend",
  "version": "0.0.0",
  "description": "bng-metric-backend",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "workspaces": [
    "bng-metric-engine"
  ],
  "scripts": {
    "db:update": "scripts/liquibase.sh update",
    "db:validate": "scripts/liquibase.sh validate",
    "predev": "node scripts/ensure-env.js",
    "dev": "NODE_ENV=development USE_SWAGGER=true npm run server:watch",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "git:pre-push-hook": "npm run test:integration:full",
    "install:gitleaks": "node scripts/install-gitleaks.mjs",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "postinstall": "node scripts/postinstall.mjs",
    "security-audit": "npm audit --audit-level=high",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch:9230": "nodemon --inspect=0.0.0.0:9230 --ext js,json --legacy-watch ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:integration": "TZ=UTC vitest run --config vitest.integration.config.js",
    "test:integration:coverage": "TZ=UTC vitest run --config vitest.integration.config.js --coverage --coverage.enabled",
    "test:integration:routes": "node scripts/assert-route-coverage.mjs",
    "test:integration:full": "npm run test:integration:coverage && npm run test:integration:routes"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1038.0",
    "@aws-sdk/credential-providers": "3.1016.0",
    "@aws-sdk/rds-signer": "3.1016.0",
    "@defra/cdp-auditing": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.4",
    "@hapi/inert": "7.1.0",
    "@hapi/wreck": "18.1.0",
    "aws-embedded-metrics": "4.2.1",
    "aws4": "1.13.2",
    "better-sqlite3": "12.9.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "global-agent": "3.0.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.1",
    "https-proxy-agent": "7.0.6",
    "joi": "18.0.2",
    "node-fetch": "3.3.2",
    "pg": "8.20.0",
    "pg-pool": "3.13.0",
    "pino": "10.1.0",
    "pino-pretty": "13.1.3",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-dist": "5.32.4",
    "undici": "7.24.6",
    "wkx": "0.5.0",
    "bng-metric-engine": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@types/node": "24.11.1",
    "@vitest/coverage-v8": "4.0.16",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "neostandard": "0.12.2",
    "nodemon": "3.1.11",
    "npm-run-all": "4.1.5",
    "prettier": "3.7.4",
    "vitest": "4.0.16",
    "vitest-fetch-mock": "0.4.5"
  }
}
